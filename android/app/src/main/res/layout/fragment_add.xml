<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catat Transaksi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_main"
            android:layout_marginBottom="16dp" />

        <!-- Main Form Card (Identical to Web) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 1. Segmented Toggle: Keluar / Masuk / Pindah -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeExpense"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📉 Keluar"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeIncome"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="📈 Masuk"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTypeTransfer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="⇄ Pindah"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- 2. Input Jumlah (with prefix Rp) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumlah"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:prefixText="Rp "
                    app:prefixTextColor="@color/text_main"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 3. Kategori Area (Hidden for Transfer) -->
                <LinearLayout
                    android:id="@+id/layoutCategoryArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Contoh: Makanan, Transport, Gaji"
                            android:textSize="14sp"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Category Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMakan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍜 Makan &amp; Minum"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipBelanja"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🛒 Belanja"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTagihan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💡 Tagihan"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTransport"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⛽ Transportasi"
                                android:textSize="11sp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGaji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💵 Pemasukan"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- 4. Dompet / Rekening Selector -->
                <TextView
                    android:id="@+id/tvAccountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dompet"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerAccount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_bg"
                        android:paddingHorizontal="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickAddAccount"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Dompet Tujuan (Khusus Transfer/Pindah) -->
                <LinearLayout
                    android:id="@+id/layoutTargetAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dompet Tujuan (Masuk)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/spinnerTargetAccount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>

                <!-- 5. Keterangan / Catatan Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan / Keterangan (Opsional)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Contoh: Kopi Janji Jiwa, Token Listrik, dsb."
                        android:textSize="14sp"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- 6. Action Buttons: Batal & Simpan (Identical to Web) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelTxn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Batal"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveTxn"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:text="+ Simpan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
